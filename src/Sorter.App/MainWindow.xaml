<Window x:Class="Sorter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sorter · Sample library" Width="1120" Height="760" MinWidth="820" MinHeight="560" Background="#101217" Foreground="#E9EDF5" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#98A3B6"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#252B38"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="BorderBrush" Value="#374154"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A99BFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D4CAFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#191D26"/><Setter Property="Foreground" Value="#98A3B6"/><Setter Property="Padding" Value="18,13"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#2B3140"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#171B23"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="MinHeight" Value="68"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#222838"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#302C48"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,28">
      <Border DockPanel.Dock="Right" Background="#20342E" CornerRadius="12" Padding="12,6" VerticalAlignment="Top"><TextBlock Text="●  Originals preserved" Foreground="#8BDFB9" FontSize="12"/></Border>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#AD9DFF" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Sorter" FontSize="30" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Less digging. More making." Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="14"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#191D26" BorderBrush="#2B3140" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18"><Button x:Name="SourceButton" DockPanel.Dock="Right" Click="ChooseSource" Margin="20,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Choose library"/></StackPanel></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="SOURCE LIBRARY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="SourcePath" Text="Select your sample library" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></DockPanel>
        <DockPanel Grid.Row="1"><Button x:Name="DestinationButton" DockPanel.Dock="Right" Click="ChooseDestination" Margin="20,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Choose output"/></StackPanel></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="ORGANIZED COPY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="DestinationPath" Text="" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></DockPanel>
      </Grid>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock DockPanel.Dock="Right" Text="WAV tags + name matching" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="Your samples" FontSize="18" FontWeight="SemiBold"/><Border Background="#28243C" CornerRadius="10" Padding="9,3" Margin="10,0,0,0" HorizontalAlignment="Left"><TextBlock x:Name="SampleCount" Text="0 files" Foreground="#C2B7FF" FontSize="11"/></Border></DockPanel>
    <Border Grid.Row="3" Background="#171B23" BorderBrush="#2B3140" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="SamplesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#242A36" SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="SAMPLE / FOLDER" Width="*" SortMemberPath="FileName"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid ToolTip="{Binding RelativePath}"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#8A82B4" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="CATEGORY" Width="160" SortMemberPath="Category"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding BadgeBackground}" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{Binding BadgeForeground}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding Category}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="MATCHED BY" Width="145" SortMemberPath="MatchSource"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MatchSource}" Foreground="{StaticResource Muted}" FontSize="12" ToolTip="{Binding Reason}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20,45,20,20"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#75679E" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="A little order for your sound collection" FontSize="16" Margin="0,16,0,8" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Choose a library, then scan to discover your samples." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready when you are." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ScanButton" Click="Scan"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Scan library"/></StackPanel></Button><Button x:Name="CopyButton" Background="#B4A1FF" Foreground="#171222" BorderBrush="#B4A1FF" Margin="10,0,0,0" IsEnabled="False" Click="Copy"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Copy organized library"/></StackPanel></Button></StackPanel></Grid>
  </Grid>
</Window>
