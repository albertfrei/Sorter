<Window x:Class="Sorter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sorter · Sample library" Width="1000" Height="680" MinWidth="720" MinHeight="480" Background="#F5F6FA">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Your sounds, organized." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Preview categories from WAV metadata, filenames and folders. Originals stay in place." Margin="0,8,0,20" Foreground="#526078"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,18">
      <DockPanel Margin="0,0,0,10"><Button x:Name="SourceButton" DockPanel.Dock="Right" Content="Choose library…" Padding="16,8" Click="ChooseSource"/><TextBox x:Name="SourcePath" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,12,0"/></DockPanel>
      <DockPanel><Button x:Name="DestinationButton" DockPanel.Dock="Right" Content="Choose output…" Padding="16,8" Click="ChooseDestination"/><TextBox x:Name="DestinationPath" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,12,0"/></DockPanel>
    </StackPanel>
    <DataGrid Grid.Row="2" x:Name="SamplesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="White">
      <DataGrid.Columns><DataGridTextColumn Header="Sample" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="2*"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ScanButton" Content="Scan library" Padding="18,10" Click="Scan"/><Button x:Name="CopyButton" Content="Copy organized library" Padding="18,10" Margin="10,0,0,0" IsEnabled="False" Click="Copy"/></StackPanel><TextBlock x:Name="Status" Text="Choose a sample library to begin." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
  </Grid>
</Window>
